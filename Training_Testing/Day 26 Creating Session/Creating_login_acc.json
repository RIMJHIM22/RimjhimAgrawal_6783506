{
  "info": {
    "_postman_id": "b35fc9ec-0baa-4976-ad7f-56a34373e5e1",
    "name": "ShopperStack",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "53447975"
  },
  "item": [
    {
      "name": "Creating Account",
      "item": [
        {
          "name": "Creating Account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.globals.set(\"BaseURL\", \"https://www.shoppersstack.com/shopping\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Account created successfully\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "let res = pm.response.json();",
                  "pm.expect(res).to.have.property(\"data\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Jaipur\",\n  \"country\": \"India\",\n  \"email\": \"testusers@gmail.com\",\n  \"firstName\": \"Rimjhim\",\n  \"gender\": \"FEMALE\",\n  \"lastName\": \"Agarwal\",\n  \"password\": \"Password@1234\",\n  \"phone\": 9587857489,\n  \"state\": \"Rajasthan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BaseURL}}/shoppers",
              "host": [
                "{{BaseURL}}"
              ],
              "path": [
                "shoppers"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Login",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let response = pm.response.json();",
                  "pm.globals.set(\"token\", response.data.jwtToken);",
                  "pm.globals.set(\"shopperId\", response.data.userId);",
                  "",
                  "pm.test(\"Token generated\", function () {",
                  "    pm.expect(response.data.jwtToken).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testusers@gmail.com\",\n  \"password\": \"Password@1234\",\n  \"role\": \"SHOPPER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BaseURL}}/users/login",
              "host": [
                "{{BaseURL}}"
              ],
              "path": [
                "users",
                "login"
              ]
            }
          }
        }
      ]
    }
  ]
}